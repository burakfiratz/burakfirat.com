---
// Astro's built-in Shiki highlighter already styles markdown code fences
// inside `.prose` (see global.css). This component progressively enhances
// every rendered <pre> with a language badge and an interactive copy button.
---

<script>
	const languageMap: Record<string, string> = {
		js: 'JavaScript',
		javascript: 'JavaScript',
		ts: 'TypeScript',
		typescript: 'TypeScript',
		json: 'JSON',
		html: 'HTML',
		css: 'CSS',
		scss: 'SCSS',
		sass: 'SASS',
		bash: 'Bash',
		sh: 'Bash',
		shell: 'Shell',
		zsh: 'Zsh',
		py: 'Python',
		python: 'Python',
		astro: 'Astro',
		md: 'Markdown',
		markdown: 'Markdown',
		vue: 'Vue',
		react: 'React',
		jsx: 'JSX',
		tsx: 'TSX',
		php: 'PHP',
		sql: 'SQL',
		yaml: 'YAML',
		yml: 'YAML',
		text: 'Metin',
		txt: 'Metin',
		go: 'Go',
		golang: 'Go',
		rust: 'Rust',
		rs: 'Rust',
		c: 'C',
		cpp: 'C++',
		docker: 'Docker',
		dockerfile: 'Dockerfile',
		toml: 'TOML',
		graphql: 'GraphQL',
		gql: 'GraphQL',
		diff: 'Diff',
	};

	async function copyToClipboard(text: string) {
		if (navigator.clipboard && window.isSecureContext) {
			await navigator.clipboard.writeText(text);
		} else {
			const textArea = document.createElement('textarea');
			textArea.value = text;
			textArea.style.position = 'fixed';
			textArea.style.left = '-999999px';
			textArea.style.top = '-999999px';
			document.body.appendChild(textArea);
			textArea.focus();
			textArea.select();
			document.execCommand('copy');
			textArea.remove();
		}
	}

	function enhanceCodeBlocks() {
		const preElements = document.querySelectorAll<HTMLElement>('.prose pre');

		preElements.forEach((pre) => {
			if (pre.dataset.enhanced === 'true') return;
			pre.dataset.enhanced = 'true';

			// Make pre container relative and grouped for hover interactions
			pre.classList.add('group', 'relative');

			const toolbar = document.createElement('div');
			toolbar.className =
				'absolute right-2.5 top-2.5 z-10 flex items-center gap-1.5 select-none opacity-90 transition-opacity sm:opacity-0 sm:group-hover:opacity-100 sm:focus-within:opacity-100';

			// Language Badge
			const rawLang = pre.getAttribute('data-language') || '';
			if (rawLang) {
				const formattedLang =
					languageMap[rawLang.toLowerCase()] || rawLang.toUpperCase();
				const badge = document.createElement('span');
				badge.className =
					'pointer-events-none rounded border border-border/80 bg-bg/90 px-1.5 py-0.5 font-mono text-[0.65rem] font-medium uppercase tracking-wider text-text-muted shadow-xs backdrop-blur-sm';
				badge.textContent = formattedLang;
				toolbar.appendChild(badge);
			}

			// Copy Button
			const button = document.createElement('button');
			button.type = 'button';
			button.setAttribute('aria-label', 'Kodu kopyala');
			button.className =
				'flex cursor-pointer items-center gap-1.5 rounded border border-border/80 bg-bg/90 px-2 py-0.5 font-mono text-xs text-text-muted shadow-xs backdrop-blur-sm transition-colors hover:border-accent hover:text-text hover:bg-bg focus-visible:outline-2 focus-visible:outline-accent';

			button.innerHTML = `
				<svg class="copy-icon size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
					<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
				</svg>
				<svg class="check-icon size-3.5 shrink-0 hidden text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="20 6 9 17 4 12" />
				</svg>
				<span class="copy-label">Kopyala</span>
			`;

			const copyIcon = button.querySelector<SVGElement>('.copy-icon');
			const checkIcon = button.querySelector<SVGElement>('.check-icon');
			const copyLabel = button.querySelector<HTMLSpanElement>('.copy-label');

			let resetTimeout: ReturnType<typeof setTimeout> | undefined;

			button.addEventListener('click', async () => {
				const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
				try {
					await copyToClipboard(code);

					if (copyIcon && checkIcon && copyLabel) {
						copyIcon.classList.add('hidden');
						checkIcon.classList.remove('hidden');
						copyLabel.textContent = 'Kopyalandı!';
						button.classList.add('border-accent', 'text-accent');

						if (resetTimeout) clearTimeout(resetTimeout);
						resetTimeout = setTimeout(() => {
							copyIcon.classList.remove('hidden');
							checkIcon.classList.add('hidden');
							copyLabel.textContent = 'Kopyala';
							button.classList.remove('border-accent', 'text-accent');
						}, 2000);
					}
				} catch (err) {
					console.error('Kopyalama işlemi başarısız oldu:', err);
				}
			});

			toolbar.appendChild(button);
			pre.appendChild(toolbar);
		});
	}

	// Initialize on page load and support Astro View Transitions if active
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', enhanceCodeBlocks);
	} else {
		enhanceCodeBlocks();
	}
	document.addEventListener('astro:page-load', enhanceCodeBlocks);
</script>
