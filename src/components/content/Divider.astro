---
// Hairline rule with an optional subtle inline-SVG "brushstroke" mark —
// the one decorative nod to Sumi's ink identity, kept minimal on purpose.
interface Props {
	ink?: boolean;
	class?: string;
}
const { ink = false, class: className = '' } = Astro.props;
---

{
	ink ? (
		<div class:list={['flex justify-center py-2', className]} role="separator">
			<svg width="64" height="12" viewBox="0 0 64 12" fill="none" class="text-border">
				<path
					d="M2 8c8-6 14 5 20-1s12 6 20 0 12-4 20 1"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
				/>
			</svg>
		</div>
	) : (
		<hr class:list={['border-border', className]} />
	)
}
