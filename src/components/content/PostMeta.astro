---
interface Props {
	pubDate: Date;
	readingMinutes?: number;
	tags?: string[];
	class?: string;
}

const {
	pubDate,
	readingMinutes,
	tags = [],
	class: className = '',
} = Astro.props;

const formatted = pubDate.toLocaleDateString('tr-TR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<div
	class:list={[
		'flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-text-muted',
		className,
	]}
>
	<time datetime={pubDate.toISOString()}>{formatted}</time>

	{readingMinutes && (
		<>
			<span aria-hidden="true">·</span>
			<span>{readingMinutes} dk okuma</span>
		</>
	)}

	{tags.length > 0 && (
		<>
			<span aria-hidden="true">·</span>

			<div class="flex flex-wrap gap-x-3">
				{tags.map((tag) => (
					<span>#{tag}</span>
				))}
			</div>
		</>
	)}
</div>