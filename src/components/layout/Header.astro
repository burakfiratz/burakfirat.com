---
import ThemeToggle from '../ui/ThemeToggle.astro';
import SearchPalette from '../ui/SearchPalette.astro';
import MobileNav from './MobileNav.astro';
import PageContainer from './PageContainer.astro';

const items = [
	{ label: 'Yazılar', href: '/blog' },
	{ label: 'Projeler', href: '/projects' },
	{ label: 'Hakkımda', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-border bg-bg/90 backdrop-blur">
	<PageContainer wide class="flex h-14 items-center justify-between gap-4">
		<a href="/" class="font-display text-h4 font-medium text-text">Burak Fırat</a>

		<nav aria-label="Ana gezinme" class="hidden items-center gap-1 md:flex">
			{
				items.map((item) => (
					<a
						href={item.href}
						aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
						class="rounded-md px-3 py-2 text-sm text-text-muted transition-colors hover:text-text aria-[current=page]:text-text"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-1">
			<SearchPalette />
			<ThemeToggle />
			<MobileNav items={items} />
		</div>
	</PageContainer>
</header>