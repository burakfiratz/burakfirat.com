---
import GithubIcon from '../icons/GithubIcon.astro';
import LinkedinIcon from '../icons/LinkedinIcon.astro';
import RssIcon from '../icons/RssIcon.astro';
import IconButton from '../ui/IconButton.astro';

interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['flex items-center gap-1', className]}>
	<IconButton href="https://github.com/burakfiratz" label="GitHub">
		<GithubIcon />
	</IconButton>
	<IconButton href="https://linkedin.com/in/burakfiratz" label="LinkedIn">
		<LinkedinIcon />
	</IconButton>
	<IconButton href="/rss.xml" label="RSS beslemesi">
		<RssIcon />
	</IconButton>
</div>
