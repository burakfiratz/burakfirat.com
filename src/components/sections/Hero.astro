---
import Button from '../ui/Button.astro';

interface Props {
	eyebrow?: string;
	title: string;
	lede: string;
	primaryCta?: { label: string; href: string };
	secondaryCta?: { label: string; href: string };
}
const { eyebrow, title, lede, primaryCta, secondaryCta } = Astro.props;
---

<section class="py-16 sm:py-24">
	{eyebrow && <p class="text-label font-semibold uppercase text-accent">{eyebrow}</p>}
	<h1 class="mt-3 text-display font-medium text-text">{title}</h1>
	<p class="mt-5 max-w-prose text-lede text-text-muted">{lede}</p>
	{(primaryCta || secondaryCta) && (
		<div class="mt-8 flex flex-wrap gap-3">
			{primaryCta && <Button href={primaryCta.href}>{primaryCta.label}</Button>}
			{secondaryCta && (
				<Button href={secondaryCta.href} variant="secondary">
					{secondaryCta.label}
				</Button>
			)}
		</div>
	)}
</section>
