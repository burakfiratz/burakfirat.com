---
// Kyoto-inspired "what I'm doing now" block. Single static entry for v1 —
// promote to a content collection only if multiple dated snapshots are wanted.
interface Props {
	updatedAt: Date;
}
const { updatedAt } = Astro.props;
const formatted = updatedAt.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="rounded-lg border border-border bg-bg-subtle p-6">
	<p class="text-label font-semibold uppercase text-accent">Şu anda</p>
	<p class="mt-3 text-body text-text">
		<slot />
	</p>
	<p class="mt-4 text-xs text-text-muted">Son güncelleme: {formatted}</p>
</section>
