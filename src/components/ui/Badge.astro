---
interface Props {
	variant?: 'neutral' | 'accent';
	class?: string;
}

const { variant = 'neutral', class: className = '' } = Astro.props;

const variants = {
	neutral: 'bg-bg-subtle text-text-muted',
	accent: 'bg-accent-subtle text-accent',
};
---

<span class:list={['inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium', variants[variant], className]}>
	<slot />
</span>
