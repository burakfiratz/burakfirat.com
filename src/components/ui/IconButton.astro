---
interface Props {
	href?: string;
	label: string;
	class?: string;
}

const { href, label, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
	href={href}
	aria-label={label}
	type={href ? undefined : 'button'}
	class:list={['inline-flex size-9 items-center justify-center rounded-full text-text-muted transition-colors hover:bg-bg-subtle hover:text-text', className]}
>
	<slot />
</Tag>
