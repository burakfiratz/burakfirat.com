---
interface Props {
	placeholder?: string;
	class?: string;
}

const { placeholder = 'Ara...', class: className = '' } = Astro.props;
---

<label class:list={['flex items-center gap-2 rounded-md border border-border bg-bg px-3 py-2 text-sm text-text-muted focus-within:border-accent', className]}>
	<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="11" cy="11" r="8"></circle>
		<path d="m21 21-4.35-4.35"></path>
	</svg>
	<input type="search" {placeholder} class="w-full bg-transparent text-text placeholder:text-text-muted focus:outline-none" />
</label>
