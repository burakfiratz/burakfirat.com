---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects', ({ data }) => !data.draft);

const items = [
	...posts.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		tags: post.data.tags || [],
		href: `/blog/${post.id}`,
		kind: 'Yazı',
	})),
	...projects.map((project) => ({
		title: project.data.title,
		description: project.data.description,
		tags: project.data.stack || [],
		href: `/projects/${project.id}`,
		kind: 'Proje',
	})),
].sort((a, b) => a.title.localeCompare(b.title, 'tr'));
---

<button
	id="search-trigger"
	type="button"
	class="hidden items-center gap-2 rounded-md border border-border bg-bg px-3 py-1.5 text-sm text-text-muted transition-colors hover:border-accent hover:text-text sm:flex"
>
	<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="11" cy="11" r="8"></circle>
		<path d="m21 21-4.35-4.35"></path>
	</svg>
	Ara
	<kbd class="ml-2 rounded border border-border px-1.5 py-0.5 font-mono text-xs text-text-muted">⌘K</kbd>
</button>

<button
	id="search-trigger-mobile"
	type="button"
	aria-label="Ara"
	class="inline-flex size-9 items-center justify-center rounded-full text-text-muted hover:bg-bg-subtle hover:text-text sm:hidden"
>
	<svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="11" cy="11" r="8"></circle>
		<path d="m21 21-4.35-4.35"></path>
	</svg>
</button>

<dialog
	id="search-dialog"
	aria-label="Site içi arama"
	class="fixed inset-x-0 top-16 sm:top-24 z-50 mx-auto my-0 w-[calc(100%-2rem)] max-w-lg rounded-xl border border-border bg-bg p-0 text-text shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-xs open:flex open:flex-col"
>
	<div class="flex items-center gap-2 border-b border-border px-4 py-3">
		<svg class="size-4 shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="8"></circle>
			<path d="m21 21-4.35-4.35"></path>
		</svg>
		<input
			id="search-dialog-input"
			type="search"
			aria-label="Yazı veya proje ara"
			placeholder="Yazı veya proje ara..."
			autocomplete="off"
			spellcheck="false"
			class="w-full bg-transparent text-body text-text placeholder:text-text-muted focus:outline-none"
		/>
		<kbd class="rounded border border-border px-1.5 py-0.5 font-mono text-xs text-text-muted">Esc</kbd>
	</div>
	<ul id="search-dialog-results" class="max-h-80 overflow-y-auto p-2" role="list"></ul>
</dialog>

<script is:inline define:vars={{ items }}>
	function setupSearchPalette() {
		const dialog = document.getElementById('search-dialog');
		const input = document.getElementById('search-dialog-input');
		const results = document.getElementById('search-dialog-results');
		const triggerDesktop = document.getElementById('search-trigger');
		const triggerMobile = document.getElementById('search-trigger-mobile');
		let selectedIndex = -1;

		if (!dialog) return;

		function render(list) {
			if (!results) return;
			selectedIndex = -1;
			if (list.length === 0) {
				results.innerHTML = '<li class="px-3 py-6 text-center text-sm text-text-muted">Sonuç bulunamadı</li>';
				return;
			}
			results.innerHTML = list
				.map(
					(item) => `
						<li>
							<a href="${item.href}" class="search-result-link flex items-center justify-between rounded-md px-3 py-2 text-sm text-text hover:bg-bg-subtle focus:bg-bg-subtle focus:outline-none transition-colors">
								<div class="flex flex-col gap-0.5 truncate pr-2">
									<span class="font-medium text-text truncate">${item.title}</span>
									${item.description ? `<span class="text-xs text-text-muted truncate">${item.description}</span>` : ''}
								</div>
								<span class="shrink-0 rounded border border-border px-1.5 py-0.5 text-xs text-text-muted">${item.kind}</span>
							</a>
						</li>`,
				)
				.join('');

			results.querySelectorAll('.search-result-link').forEach((link) => {
				link.addEventListener('click', () => {
					dialog.close();
				});
			});
		}

		function filterItems(query) {
			if (!query) return items;
			const q = query.trim().toLocaleLowerCase('tr');
			return items.filter((item) => {
				const title = (item.title || '').toLocaleLowerCase('tr');
				const desc = (item.description || '').toLocaleLowerCase('tr');
				const tags = (item.tags || []).join(' ').toLocaleLowerCase('tr');
				return title.includes(q) || desc.includes(q) || tags.includes(q);
			});
		}

		function updateSelection(links) {
			links.forEach((link, idx) => {
				if (idx === selectedIndex) {
					link.classList.add('bg-bg-subtle');
					link.scrollIntoView({ block: 'nearest' });
				} else {
					link.classList.remove('bg-bg-subtle');
				}
			});
		}

		function open() {
			if (!dialog) return;
			if (typeof dialog.showModal === 'function') {
				dialog.showModal();
			} else {
				dialog.setAttribute('open', '');
			}
			render(items);
			if (input) {
				input.value = '';
				input.focus();
			}
		}

		triggerDesktop?.addEventListener('click', open);
		triggerMobile?.addEventListener('click', open);

		input?.addEventListener('input', () => {
			render(filterItems(input.value));
		});

		input?.addEventListener('keydown', (e) => {
			const links = results?.querySelectorAll('a');
			if (!links || links.length === 0) return;

			if (e.key === 'ArrowDown') {
				e.preventDefault();
				selectedIndex = (selectedIndex + 1) % links.length;
				updateSelection(links);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				selectedIndex = (selectedIndex - 1 + links.length) % links.length;
				updateSelection(links);
			} else if (e.key === 'Enter') {
				if (selectedIndex >= 0 && selectedIndex < links.length) {
					e.preventDefault();
					dialog.close();
					links[selectedIndex].click();
				}
			}
		});

		dialog.addEventListener('click', (e) => {
			const rect = dialog.getBoundingClientRect();
			const isInDialog =
				rect.top <= e.clientY &&
				e.clientY <= rect.top + rect.height &&
				rect.left <= e.clientX &&
				e.clientX <= rect.left + rect.width;
			if (!isInDialog) dialog.close();
		});
	}

	if (!window.__search_palette_keydown_bound) {
		window.__search_palette_keydown_bound = true;
		document.addEventListener('keydown', (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
				e.preventDefault();
				const dialog = document.getElementById('search-dialog');
				if (dialog) {
					if (dialog.open) {
						dialog.close();
					} else {
						if (typeof dialog.showModal === 'function') {
							dialog.showModal();
						} else {
							dialog.setAttribute('open', '');
						}
						const input = document.getElementById('search-dialog-input');
						if (input) {
							input.value = '';
							input.focus();
						}
					}
				}
			}
		});
	}

	setupSearchPalette();
	document.addEventListener('astro:page-load', setupSearchPalette);
</script>
