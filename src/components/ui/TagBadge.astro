---
interface Props {
	href?: string;
	class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
	href={href}
	class:list={[
		'inline-flex items-center rounded-full bg-bg-subtle px-2.5 py-1 text-xs text-text-muted transition-colors',
		href && 'hover:bg-accent-subtle hover:text-accent',
		className,
	]}
>
	<slot />
</Tag>
