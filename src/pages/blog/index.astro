---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageContainer from '../../components/layout/PageContainer.astro';
import Hero from '../../components/sections/Hero.astro';
import PostCard from '../../components/cards/PostCard.astro';
import TagList from '../../components/cards/TagList.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCounts.entries()].map(([name, count]) => ({ name, count }));
---

<BaseLayout
	title="Yazılar — Burak Fırat"
	description="Burak Fırat'ın yazılım, teknoloji ve sistemler üzerine yazıları."
>
	<Header />

	<main id="main">
		<PageContainer wide>
			<Hero
				eyebrow="Yazılar"
				title="Düşünceler, notlar ve öğrendiklerim."
				lede="Yazılım, teknoloji, sistemler ve zaman zaman ilgimi çeken başka şeyler."
			/>

			{tags.length > 0 && <TagList tags={tags} class="mb-8" />}

			<section class="max-w-3xl pb-24">
				<div class="mb-2 flex items-center justify-between border-b border-border pb-3">
					<span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-text-muted">
						Tüm yazılar
					</span>

					<span class="text-xs text-text-muted">
						{posts.length} yazı
					</span>
				</div>

				<div>
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			</section>
		</PageContainer>
	</main>

	<Footer />
</BaseLayout>