---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageContainer from '../../components/layout/PageContainer.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const {
	title,
	description,
	summary,
	startDate,
	endDate,
	ongoing,
	cover,
	coverAlt,
	stack,
	role,
	links,
} = project.data;

const yearLabel = ongoing
	? `${startDate.getFullYear()} — devam ediyor`
	: endDate
		? `${startDate.getFullYear()}–${endDate.getFullYear()}`
		: `${startDate.getFullYear()}`;
---

<BaseLayout
	title={`${title} — Burak Fırat`}
	description={description}
>
	<Header />

	<main id="main">
		<PageContainer wide>
			<article class="py-12 sm:py-20">
				<a
					href="/projects"
					class="text-sm text-text-muted transition-colors hover:text-text"
				>
					← Tüm projeler
				</a>

				<header class="mt-10 max-w-4xl">
					<p class="text-sm text-text-muted">
						{yearLabel}
					</p>

					<h1 class="mt-3 font-display text-display font-medium tracking-tight text-text">
						{title}
					</h1>

					<p class="mt-6 max-w-2xl text-lede text-text-muted">
						{description}
					</p>
				</header>

				<div class="mt-12 overflow-hidden bg-bg-subtle">
					<Image
						src={cover}
						alt={coverAlt}
						width={1400}
						height={700}
						class="aspect-[2/1] w-full object-cover"
					/>
				</div>

				<div class="mt-10 grid gap-10 border-y border-border py-8 sm:grid-cols-3">
					<div>
						<p class="text-xs uppercase tracking-wide text-text-muted">
							Role
						</p>
						<p class="mt-2 text-sm text-text">
							{role ?? '—'}
						</p>
					</div>

					<div>
						<p class="text-xs uppercase tracking-wide text-text-muted">
							Stack
						</p>
						<p class="mt-2 text-sm text-text">
							{stack.join(' · ')}
						</p>
					</div>

					<div>
						<p class="text-xs uppercase tracking-wide text-text-muted">
							Links
						</p>

						{links.length > 0 ? (
							<div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
								{links.map((link) => (
									<a
										href={link.url}
										target="_blank"
										rel="noreferrer"
										class="text-sm text-text underline decoration-border underline-offset-4 hover:decoration-text"
									>
										{link.label}
									</a>
								))}
							</div>
						) : (
							<p class="mt-2 text-sm text-text-muted">—</p>
						)}
					</div>
				</div>

				{summary && (
					<p class="mt-10 max-w-3xl font-display text-h3 text-text">
						{summary}
					</p>
				)}

				<div class="prose mt-10 max-w-3xl">
					<Content />
				</div>
			</article>
		</PageContainer>
	</main>

	<Footer />
</BaseLayout>